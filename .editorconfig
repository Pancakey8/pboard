# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
indent_style = space
indent_size = 2
tab_width = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Optional: Specific overrides for file types if needed (e.g., Makefiles usually require actual tabs)
[Makefile]
indent_style = tab
